{
  "manifest_version": 3,
  "name": "Hyper Cookies",
  "version": "1.1.1",
  "minimum_chrome_version": "120",
  "description": "Tiện ích nội bộ để xem, sao chép và quản lý cookie ngay trong trình duyệt.",
  "permissions": ["cookies", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://drive.google.com/*", "https://drive.usercontent.google.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"
  },
  "action": {
    "default_title": "Hyper Cookies",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/10.png",
      "32": "images/10.png",
      "48": "images/10.png",
      "128": "images/10.png"
    }
  },
  "icons": {
    "16": "images/10.png",
    "32": "images/10.png",
    "48": "images/10.png",
    "128": "images/10.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
